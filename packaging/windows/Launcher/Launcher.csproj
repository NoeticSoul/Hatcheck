<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>Hatcheck</AssemblyName>
    <RootNamespace>Hatcheck.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Copyright>Copyright Hatcheck contributors. Apache-2.0.</Copyright>
    <Description>Unsigned pilot launcher for the shared Hatcheck HTTPS application.</Description>
  </PropertyGroup>
  <Target Name="IncludeRuntimeNotices" AfterTargets="Publish">
    <Copy SourceFiles="$(NuGetPackageRoot)/microsoft.netcore.app.runtime.win-x64/$(RuntimeFrameworkVersion)/LICENSE.TXT"
          DestinationFiles="$(PublishDir)DOTNET-LICENSE.txt" />
    <Copy SourceFiles="$(NuGetPackageRoot)/microsoft.netcore.app.runtime.win-x64/$(RuntimeFrameworkVersion)/THIRD-PARTY-NOTICES.TXT"
          DestinationFiles="$(PublishDir)DOTNET-THIRD-PARTY-NOTICES.txt" />
  </Target>
</Project>
