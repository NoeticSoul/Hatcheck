{
  "name": "hatcheck",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted IT management platform: assets, locations, imaging pipeline, knowledge base, doc studio.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "vite src/web",
    "build": "vite build src/web",
    "start": "bun src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "compile": "bun scripts/compile.ts",
    "package:windows": "pwsh -NoProfile -File scripts/package-windows.ps1",
    "db:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts && drizzle-kit generate --config=drizzle.pg.config.ts",
    "seed": "bun src/db/seed.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "@node-rs/argon2",
    "esbuild",
    "@tailwindcss/oxide"
  ],
  "overrides": {
    "esbuild": "0.25.12",
    "source-map-js": "1.2.2"
  }
}
