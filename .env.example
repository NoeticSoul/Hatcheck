# Hatcheck environment configuration.
# Copy to .env and adjust. All secrets come from environment variables only
# (see SECURITY.md) -- never commit a real .env file.

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# HTTP port the API server listens on.
PORT=3000

# Public base URL of the app. Defaults to http://localhost:$PORT if unset.
# Set this when running behind a reverse proxy or a non-localhost hostname.
#APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# sqlite (standalone mode, default) | postgres (server mode)
HATCHECK_DB=sqlite

# PostgreSQL accepts DATABASE_URL or all of PGHOST/PGUSER/PGPASSWORD/PGDATABASE.
# Discrete fields encode passwords safely, including #, ?, /, @ and %.
#DATABASE_URL=postgres://hatcheck_app:encoded-password@localhost:5432/hatcheck
#PGHOST=localhost
#PGPORT=5432
#PGUSER=hatcheck_app
#PGPASSWORD=
#PGDATABASE=hatcheck

# AWS RDS / remote PostgreSQL: verify the CA and server hostname. The bundled
# RDS truststore is public certificate material, never database credentials.
# Default inherit preserves existing URI transport options for local setups.
#HATCHECK_PG_SSL_MODE=verify-full
#HATCHECK_PG_SSL_ROOT_CERT=/app/infra/aws/rds-ca/global-bundle.pem

# Compose applies migrations/bootstrap with a separate owner before startup.
# Other deployments default to applying both during startup.
#HATCHECK_SKIP_MIGRATIONS=false
#HATCHECK_SKIP_BOOTSTRAP=false

# SQLite database file location (standalone mode only).
HATCHECK_SQLITE_PATH=./data/hatcheck.db

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------

# Forwarded addresses are trusted only when the connecting peer is explicitly
# listed here and the proxy appends the actual client IP to X-Forwarded-For.
# Use literal IPv4/IPv6 addresses or explicit subnet CIDRs (no hostnames or
# wildcards). For ALB, restrict task ingress to its security group and trust
# only its subnet ranges. Missing socket evidence and other peers ignore them.
#HATCHECK_TRUST_PROXY=false
#HATCHECK_TRUSTED_PROXIES=127.0.0.1,::1

# ---------------------------------------------------------------------------
# OIDC single sign-on (optional)
# ---------------------------------------------------------------------------
# Leave all of these unset to run with local accounts only. If you set one of
# ISSUER / CLIENT_ID / CLIENT_SECRET you must set all three.

#OIDC_ISSUER=https://idp.example.test/realms/hatcheck
#OIDC_CLIENT_ID=hatcheck
#OIDC_CLIENT_SECRET=change-me
# Defaults to $APP_URL/api/v1/auth/oidc/callback if unset.
#OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback

# Every login requires email_verified=true. Identity is bound to issuer+sub;
# legacy issuer-less accounts must be explicitly migrated by an administrator.
# New account provisioning is OFF unless enabled with exact admitted domains.
# Automatically admitted accounts receive readonly, never admin.
#OIDC_AUTO_PROVISION=false
#OIDC_ALLOWED_EMAIL_DOMAINS=hatcheck.test

# ---------------------------------------------------------------------------
# AI adapter (optional, off by default)
# ---------------------------------------------------------------------------

# anthropic | openai | ollama -- leave unset to disable all AI features.
#HATCHECK_AI_PROVIDER=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------

# Initial admin password for `bun run seed`. If unset, the seed script
# generates a random one and prints it once.
#HATCHECK_SEED_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Docker Compose (server mode)
# ---------------------------------------------------------------------------

# Required secrets for distinct PostgreSQL bootstrap, migration-owner, and
# restricted application roles. Supply securely; never commit their values.
#POSTGRES_PASSWORD=
#POSTGRES_OWNER_PASSWORD=
#POSTGRES_APP_PASSWORD=
# Database selected after a tested restore (the bundled initial DB is hatcheck).
#HATCHECK_PG_DATABASE=hatcheck

# Offline recovery only, with all API workers stopped. See docs/OPERATIONS.md.
# Use secure environment bindings; never retain recovery passwords in this file.
#HATCHECK_RECOVERY_EMAIL=admin@hatcheck.test
#HATCHECK_RECOVERY_PASSWORD=
